# Smart Dam Frontend Configuration
# =================================
# Leave VITE_API_URL empty or remove it to use auto-detection:
#   - localhost frontend → targets http://localhost:5000
#   - deployed frontend → targets Render cloud URL
#
# Or set it explicitly:
#   VITE_API_URL=http://localhost:5000        # for local backend
#   VITE_API_URL=https://smart-dam-system-using-iot-ml-cv.onrender.com  # for cloud
VITE_API_URL=
