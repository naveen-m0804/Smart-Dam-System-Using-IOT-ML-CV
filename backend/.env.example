# Smart Dam Backend Configuration
# =================================

# MongoDB — use local MongoDB for offline, or Atlas for cloud
# LOCAL:  MONGO_URI=mongodb://localhost:27017/
# CLOUD:  MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?appName=Cluster0
MONGO_URI=mongodb://localhost:27017/
DB_NAME=smart_dam_db

# ML Model paths
MODEL_PATH=models/rainfall_model.pkl
YOLO_MODEL=yolov8n.pt

# Human detection (set false on Render or machines without webcam)
DETECTION_CONFIDENCE=0.5
DETECTION_INTERVAL=3
ENABLE_HUMAN_DETECTION=true

# CORS — comma-separated origins, or * for all
# LOCAL:  CORS_ORIGINS=*
# PROD:   CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:8080
CORS_ORIGINS=*

# Weather cache TTL in seconds
WEATHER_CACHE_TTL=300

# Security
SECRET_KEY=change-me

# Dam location coordinates
DAM_LATITUDE=12.96312116701951
DAM_LONGITUDE=79.94246446052891

# Flask port
PORT=5000
